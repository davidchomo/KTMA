# Skopíruj na .env a vyplň. Súbor .env sa necommituje.
# Iba ak v config.yaml prepneš provider: oanda (predvolený binance nič nepotrebuje)
OANDA_API_TOKEN=
OANDA_ENV=practice
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Odkaz v Telegram správe na labelovanie konkrétneho alertu
KTMA_LABEL_URL=https://ktma.mirasolen.eu
# Heslo do appky (voliteľné, ak nepoužívaš basic_auth v Caddy)
KTMA_UI_PASSWORD=
# 💬 Opýtaj sa Clauda: token z príkazu `claude setup-token` (vaše predplatné Claude, iba otázky modelu)
CLAUDE_CODE_OAUTH_TOKEN=
